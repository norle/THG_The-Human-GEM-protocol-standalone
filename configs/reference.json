{
  "workflow": "reference",
  "run": {
    "name": "thg-reference",
    "output_dir": "../runs/thg-reference"
  },
  "beta1": {
    "input_model": "../inputs/models/Human2.xml",
    "mode": "apply-all",
    "balance_strategy": "proton-water"
  },
  "beta2": {
    "mode": "apply-all",
    "compartments": {
      "a": "cell membrane",
      "c": "cytosol",
      "ci": "cilium",
      "ck": "cytoskeleton",
      "e": "extracellular",
      "g": "golgi apparatus",
      "i": "inner mitochondria",
      "l": "lysosome",
      "m": "mitochondria",
      "n": "nucleus",
      "r": "endoplasmic reticulum",
      "v": "vesicle",
      "x": "peroxisome"
    },
    "uncertainty_policy": "report"
  },
  "gapfill": {
    "remove_infeasible_loops": false,
    "method": "greedy",
    "max_additions": 100,
    "allowed_connections": [],
    "candidate_types": ["A", "B", "C"],
    "validation_profile": "structural-fast"
  }
}
