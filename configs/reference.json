{
  "workflow": "reference",
  "run": {
    "name": "thg-reference",
    "output_dir": "../runs/thg-reference"
  },
  "beta1": {
    "input_model": "../inputs/models/Human2.xml",
    "mode": "apply-all",
    "balance_strategy": "proton-water"
  },
  "beta2": {
    "n_jobs": 1,
    "evidence_mode": "live",
    "gpr_policy": "model-then-ec",
    "location_policy": "provided-then-evidence",
    "compartments": {
      "a": "cell membrane",
      "c": "cytosol",
      "ci": "cilium",
      "ck": "cytoskeleton",
      "e": "extracellular",
      "g": "golgi apparatus",
      "i": "inner mitochondria",
      "l": "lysosome",
      "m": "mitochondria",
      "n": "nucleus",
      "r": "endoplasmic reticulum",
      "v": "vesicle",
      "x": "peroxisome"
    },
    "compartment_go_terms": {
      "a": "GO:0005886",
      "c": "GO:0005829",
      "ci": "GO:0005929",
      "ck": "GO:0005856",
      "e": "GO:0005615",
      "g": "GO:0005794",
      "i": "GO:0005743",
      "l": "GO:0005764",
      "m": "GO:0005739",
      "n": "GO:0005634",
      "r": "GO:0005783",
      "v": "GO:0031982",
      "x": "GO:0005777"
    },
    "compartment_go_aliases": {
      "GO:0005737": "c"
    },
    "location_sources": [
      "goa",
      "uniprot"
    ],
    "reaction_sources": [
      "rhea",
      "reactome"
    ],
    "go_ontology_url": "https://release.geneontology.org/2026-06-19/ontology/go-basic.obo",
    "go_ontology_release": "2026-06-19",
    "source_releases": {
      "go": {
        "release": "2026-06-19",
        "url": "https://release.geneontology.org/2026-06-19/ontology/go-basic.obo"
      },
      "goa": {
        "release": "232"
      },
      "uniprot": {
        "release": "2026_02"
      },
      "rhea": {
        "release": "141"
      },
      "reactome": {
        "release": "97"
      }
    },
    "mode": "apply-all",
    "fallback_location": null,
    "uncertainty_policy": "reject-conflicts"
  },
  "gapfill": {
    "remove_infeasible_loops": false,
    "method": "sink-milp",
    "max_additions": 1000,
    "tradeoff_lambda": 0.01,
    "allowed_connections": [
      ["a", "c"],
      ["a", "ci"],
      ["a", "ck"],
      ["a", "e"],
      ["a", "r"],
      ["a", "v"],
      ["c", "ci"],
      ["c", "ck"],
      ["c", "g"],
      ["c", "l"],
      ["c", "m"],
      ["c", "n"],
      ["c", "r"],
      ["c", "v"],
      ["c", "x"],
      ["ci", "ck"],
      ["ci", "e"],
      ["e", "l"],
      ["g", "i"],
      ["m", "n"],
      ["r", "v"]
    ],
    "candidate_types": ["A", "B", "C"],
    "validation_profile": "structural-fast"
  }
}
